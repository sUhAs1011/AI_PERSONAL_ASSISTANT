flowchart LR
    U["User"] --> CHAT["/chat"]

    subgraph G["LangGraph booking_graph (/chat path)"]
      direction LR
      S["Build AgentState<br/>messages + prefs + trace_id"] --> START(("START"))
      START --> A["agent_node<br/>route_mode + mode-specific tools"]
      A --> SAN["sanitize tool calls<br/>inject user_id/timezone<br/>hydrate [event_id,start_iso]<br/>rewrite location follow-up<br/>book_event -> update_event_location"]
      SAN --> RA{"route_after_agent"}
      RA -->|tool_calls| TN["ToolNode"]
      RA -->|clarification / no tool| F["finalizer_node<br/>(single response surface)"]
      RA -->|needs_hitl| H["hitl_node"]
      TN --> TR["tool_result_node<br/>normalize execution_result"]
      TR --> RT{"route_after_tool_result"}
      RT -->|ok / error| F
      RT -->|conflict| H
      F --> END(("END"))
      H --> END
    end

    CHAT --> S
    END --> CRES["/chat ChatResponse<br/>status + summary + response_mode<br/>latest_event_id/latest_start_iso<br/>optional hitl_action_id + alternatives"]

    CRES -->|if conflict options shown| UH["User selects option"] --> HITL["/hitl/respond"]
    HITL --> RH["resolve_hitl_action<br/>(execution_result only)"] --> HF["finalizer_node"] --> HRES["/hitl/respond ChatResponse<br/>same finalizer contract"]

    subgraph T["Calendar Tools (via ToolNode)"]
      direction TB
      Q["Query: find_events, check_availability, get_event_duration"]
      ACT["Action: book_event, reschedule_event,<br/>cancel_event, update_event_duration,<br/>update_event_location, schedule_mutual"]
      MCP["MCPClient<br/>/tools/call -> REST fallback"]
      Q --> MCP
      ACT --> MCP
    end
    TN -.calls.-> Q
    TN -.calls.-> ACT

    subgraph P["Persistence / Context"]
      direction TB
      HIST["conversation_history<br/>(client-passed each turn)"]
      PREF["PreferencesRepo (SQLite)"]
      PEND["PendingActionRepo (SQLite)"]
    end
    CHAT -.uses.-> HIST
    CHAT -.reads.-> PREF
    H -.writes.-> PEND
    HITL -.reads.-> PEND
