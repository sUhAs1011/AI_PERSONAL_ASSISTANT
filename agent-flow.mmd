flowchart TD;
    U["User message + conversation_history + timezone"] --> CHAT["/chat"];
    CHAT --> S["Build AgentState<br/>messages + preferences + trace_id"];
    S --> START(("LangGraph START"));

    START --> A["agent_node<br/>route_mode: LLM-first,<br/>heuristic fallback"];
    A --> RA{"route_after_agent"};

    RA -->|tool_calls present| TN["ToolNode<br/>(proxy tools)"];
    RA -->|pending_clarification or no tool call| F["finalizer_node"];
    RA -->|needs_hitl| H["hitl_node<br/>save pending action"];

    TN --> TR["tool_result_node<br/>normalize execution_result"];
    TR --> RT{"route_after_tool_result"};
    RT -->|ok| F;
    RT -->|conflict / needs_hitl| H;

    F --> END(("END"));
    H --> END;
    END --> CRES["/chat ChatResponse<br/>summary + response_mode<br/>conversation_history (+event_id marker)<br/>may include hitl_action_id + alternatives"];

    subgraph TOOLS["Tools Layer (called by ToolNode)"]
      direction LR
      T1["find_events"];
      T2["check_availability"];
      T3["book_event"];
      T4["reschedule_event"];
      T5["cancel_event"];
      T6["schedule_mutual"];
    end
    TN --> T1;
    TN --> T2;
    TN --> T3;
    TN --> T4;
    TN --> T5;
    TN --> T6;

    subgraph MEMORY["Memory / Persistence"]
      direction LR
      M1["Conversation history<br/>(client-passed each turn)"];
      M2["PreferencesRepo (SQLite)"];
      M3["PendingActionRepo (SQLite HITL)"];
    end
    CHAT -.uses.-> M1;
    CHAT -.reads.-> M2;
    H -.writes.-> M3;

    CRES -->|if needs_hitl| UH["User selects HITL slot"];
    UH --> HITL["/hitl/respond"];
    HITL -.reads.-> M3;
    HITL --> RH["resolve_hitl_action<br/>(build execution_result only)"];
    RH --> HF["finalizer_node"];
    HF --> HRES["/hitl/respond ChatResponse<br/>(finalizer-normalized payload)"];
